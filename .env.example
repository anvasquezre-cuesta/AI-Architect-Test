# Copy to .env and fill in as needed. All values have sensible defaults.

# --- RAG answer step (only /api/ask needs an LLM) ---
# Leave OPENAI_API_KEY empty to run OCR / extraction / ingest without an LLM.
# Point OPENAI_BASE_URL at any OpenAI-compatible server (vLLM, Ollama, etc.)
# to use a fully open, self-hosted model instead of a hosted provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vector store (Compose sets QDRANT_HOST=qdrant automatically) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_documents

# --- Models (override to swap without code changes) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
SPACY_MODEL=en_core_web_sm
