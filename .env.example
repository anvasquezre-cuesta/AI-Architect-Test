# Copy to .env and adjust. All values have sane defaults (see app/config.py).

# --- Vector database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_documents
VECTOR_SIZE=384
SEARCH_TOP_K=3
SEARCH_SCORE_THRESHOLD=0.5

# --- Models ---
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OCR ---
OCR_DPI=150

# --- Fuzzy matching ---
FUZZY_THRESHOLD=90

# --- RAG chunking ---
CHUNK_SIZE=500

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
LLM_TIMEOUT=30.0

# --- Observability ---
LOG_LEVEL=INFO
