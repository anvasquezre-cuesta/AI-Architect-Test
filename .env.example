# Copy to .env and fill in as needed. All values have sensible defaults.

# --- RAG answer step (only /api/ask needs an LLM) ---
# Leave OPENAI_API_KEY empty to run OCR / extraction / ingest without an LLM
# (/api/ask then returns the retrieved passages with a clear notice).
#
# Recommended free/open option — local Ollama (no API key, no OpenAI):
#   brew install ollama && ollama serve && ollama pull qwen2.5:3b
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_MODEL=qwen2.5:3b
#   OPENAI_API_KEY=ollama
#
# Or a hosted provider (OpenAI, Groq, …) by pointing these at its endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vector store (Compose sets QDRANT_HOST=qdrant automatically) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_documents

# --- Models (override to swap without code changes) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
SPACY_MODEL=en_core_web_sm
